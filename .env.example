APP_NAME=Cloud Application
APP_VERSION=1.0
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/cloud_application
STORAGE_PATH=storage/objects

HTTPS_ENABLED=true
HTTPS_PORT=8443
SSL_CERTFILE=certs/localhost.pem
SSL_KEYFILE=certs/localhost-key.pem