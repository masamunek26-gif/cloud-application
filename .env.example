APP_NAME=Cloud Application
APP_VERSION=1.0.0
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cloud_application
DB_USER=postgres
STORAGE_PATH=storage/objects
HTTPS_ENABLED=true
HTTPS_PORT=8443
SSL_CERTFILE=certs/localhost.pem
SSL_KEYFILE=certs/localhost-key.pem

# Secrets are supplied separately via files in secrets/:
# LAB_DB_PASSWORD -> secrets/lab_db_password
# AUTH_SECRET     -> secrets/auth_secret